<?xml version="1.0" encoding="utf-8"?>
<!--
    P3-3: Configuración del servicio de accesibilidad.
    - accessibilityEventTypes: Escuche todo tipo de eventos(Haga clic/desplazarse/Cambios de ventana, etc.),Para uso de getCurrentActivityName
    - accessibilityFlags: FLAG_RETRIEVE_INTERACTIVE_WINDOWS Soporta múltiples ventanas;FLAG_REQUEST_FILTER_KEY_EVENTS Opcional
    - canRetrieveWindowContent: true Permitir la lectura del árbol de la interfaz de usuario(getUiHierarchy/setTextOnNode depender de)
    - canPerformGestures: true Permitir gestos(performClick/performSwipe depender de)
    - canTakeScreenshots: Establecer dinámicamente a través de serviceInfo en onServiceConnected(API 34+)
    - notificationTimeout: limitación de eventos 100ms
    - packageNames: no declarar = Supervise todas las aplicaciones. Tenga cuidado de no escribir una cadena vacía——La cadena vacía se analizará en“Nombre del paquete vacío”filtrar,
      Lo que da como resultado que no se entreguen eventos(La caché de la ventana está vacía,getCurrentActivityName espacio constante,rootInActiveWindow para null).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewScrolled"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />
