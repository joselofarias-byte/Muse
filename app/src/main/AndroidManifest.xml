<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v0.32: keepAwake ajustes(Mantenga la CPU activa mientras se ejecuta la aplicación) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- v0.32: autoLaunch ajustes(Iniciar automáticamente después del encendido muse) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Función1: Desbloqueo biométrico -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Phase 5-D: Entrada de voz(ACTION_RECOGNIZE_SPEECH El sistema solicitará automáticamente) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Phase 8.10: Leer eventos del calendario(calendar_today Herramientas necesarias) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Phase 8.10: Escribir evento del calendario(add_calendar_event Herramientas necesarias) -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Phase 8.10: Estadísticas de tiempo frente a la pantalla(screen_time Herramientas necesarias) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Herramientas celulares:get_location ubicación difícil(permisos de tiempo de ejecución,Autoprueba en la herramienta) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Herramientas celulares:get_contacts_count Número de contactos(permisos de tiempo de ejecución,Autoprueba en la herramienta) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Herramientas celulares:send_sms Enviar SMS(permisos de tiempo de ejecución,Autoprueba en la herramienta) -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Herramientas de control del sistema:toggle_wifi Leer el estado de WiFi(Permisos normales,concedido automáticamente) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Herramientas de control del sistema:toggle_bluetooth Leer el estado de Bluetooth -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- Herramientas de control del sistema:toggle_bluetooth Apagar Bluetooth(API 31+ Obsoleto pero compatible con versiones anteriores) -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- v1.136: linterna/control de flash(toggle_flashlight) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- v1.136: retroalimentación de vibración(vibrate) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v1.136: Modificar el brillo de la pantalla(set_brightness) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- v1.136: Android 12+ Obtener dispositivos Bluetooth emparejados(get_bluetooth_devices) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- v1.136: Recordatorio regular(schedule_reminder)Establecer alarmas precisas -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- v2.x: AlarmClock.ACTION_SET_ALARM / ACTION_SET_TIMER Requerido para iniciar la aplicación del reloj del sistema(normal Permisos,Sin ventanas emergentes en tiempo de ejecución);
         La falta anterior provocó que set_alarm/set_timer fuera interceptado por el sistema.(Permission Denial) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- v1.27: Acceso al álbum de fotos(InputBar Se requiere autorización para acceder al álbum.) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- v1.43: El servicio de recepción se mantiene vivo.(Mantenga la IA generada al cambiar al fondo) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Ventana flotante del sistema de grabación rápida.(Utilizado después de la autorización activa del usuario.) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- v2.2.1 Termux canal:Ejecute comandos a través del protocolo Termux RUN_COMMAND(El usuario otorga permisos adicionales en Termux) -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- v2.2.1 Proveedor independiente de accesibilidad: vincula su servicio puente AIDL(Permisos a nivel de firma,Sólo se pueden vincular solicitudes con la misma firma) -->
    <uses-permission android:name="io.zer0.muse.permission.A11Y_BRIDGE" />
    <!-- v2.2.1 Proveedor independiente accesible: instalador de APK desplegable en la aplicación(guía de instalación,Confirmación realizada por el instalador del sistema.) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Phase 5-I: Exportación de copia de seguridad/importar(SAF No se requiere permiso,Pero leer documentos externos requiere) -->
    <queries>
        <!-- v2.2.1 Termux canal:visibilidad del paquete(Android 11+ De lo contrario no podrás verlo Termux) -->
        <package android:name="com.termux" />
        <!-- v2.2.1 Proveedor independiente de accesibilidad: Visibilidad del paquete(Detección de instalación y unión de puentes.) -->
        <package android:name="io.zer0.muse.a11y" />
        <intent>
            <action android:name="android.intent.action.RECOGNIZE_SPEECH" />
        </intent>
        <!--
            TTS visibilidad del motor (Android 11+ visibilidad del paquete).
            Cuando falta este elemento, bindService de TextToSpeech no puede conectarse al motor: la devolución de llamada de inicialización no regresará.
            Se muestra como "TTS Siempre atascado en la inicialización" (lo mismo ocurre incluso si el dispositivo está realmente equipado con un motor).
        -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Enumeración del servicio de reconocimiento de voz (incluido el reconocimiento del lado del dispositivo), junto con RECOGNIZE_SPEECH arriba. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- v1.52: open_app La herramienta necesita consultar otras aplicaciones. launcher intent(Android 11+ visibilidad del paquete) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MuseApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Muse"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config">

        <!-- Página de vista previa de desarrollo: sin exportación, sin entrada de escritorio, solo adb puede abrirla directamente. -->

        <activity

            android:name=".ui.devpreview.DevPreviewActivity"

            android:exported="false"

            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="false"
            android:theme="@style/Theme.Muse.Starting">
            <!-- Iniciar la entrada:activity-alias La solución ha sido abandonada y regresa a la Actividad principal. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Phase 8.10: Deep Link muse:// scheme -->
            <!-- M-06/M-8: Limitar el host a valores conocidos,Evite que cualquier aplicación se inicie a través de hosts no autorizados DeepLink -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="muse" android:host="session" />
                <data android:scheme="muse" android:host="new" />
                <data android:scheme="muse" android:host="assistants" />
                <data android:scheme="muse" android:host="settings" />
                 <data android:scheme="muse" android:host="scheduled-tasks" />
                 <data android:scheme="muse" android:host="scheduled-task" />
                 <data android:scheme="muse" android:host="quick-notes" />
                 <data android:scheme="muse" android:host="quick-note" />
                 <data android:scheme="muse" android:host="chat" />
                 <data android:scheme="muse" android:host="home" />
                 <data android:scheme="muse" android:host="settings-data" />
                 <data android:scheme="muse" android:host="cloud-backup" />
                 <data android:scheme="muse" android:host="settings-about" />
                 <data android:scheme="muse" android:host="settings-agent" />
                 <data android:scheme="muse" android:host="settings-model" />
                 <data android:scheme="muse" android:host="memory" />
                 <data android:scheme="muse" android:host="knowledge" />
                 <data android:scheme="muse" android:host="knowledge-bases" />
            </intent-filter>
            <!-- P1-6: OAuth La devolución de llamada io.zer0.muse://oauth/callback se ha migrado a OAuthCallbackActivity -->
            <!-- (Fase original 10.4 pathPrefix="/callback" filter Eliminado,Evite conflictos con OAuthCallbackActivity) -->
            <!-- Phase 8.10: Recibir sistema compartido(texto plano) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <!-- Phase 8.10: Mantenga presionado para seleccionar texto → "enviado en musa" -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- v2.x: Recibir paquete de personajes(.muse-assistant) — Desde la gestión de archivos/Cuando se abre la aplicación de chat, ingresará directamente a la importación. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-muse-assistant" />
            </intent-filter>
            <!-- Launcher Atajo de pulsación larga:Registro de atajos estáticos(debe ser <activity> elemento hijo directo) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            v2.6.9: Alias de actividad del iniciador — Admite el cambio de nombre y icono para mostrar de "personalización de apariencia".

            Cada alias apunta a la misma MainActivity, pero la etiqueta/icono es diferente; por
            LauncherAppearanceManager Habilite uno de ellos a través de setComponentEnabledSetting.
            Android Es necesario que solo se pueda habilitar un alias PRINCIPAL/LANZADOR al mismo tiempo; de lo contrario, aparecerán varios íconos en el escritorio.

            Estos son nombres neutrales (no se hacen pasar por aplicaciones de terceros):
              .LauncherDefault  → Muse(predeterminado)
              .LauncherNotes    → Notas
              .LauncherMemo     → nota
              .LauncherStudy    → Registro de aprendizaje
        -->

        <!-- P1-6: OAuth devolución de llamada vacía Activity — recibir io.zer0.muse://oauth/callback Deep Link -->
        <!-- exported=true Requerido por enlace profundo(Navegador/llamada al sistema) -->
        <!-- El tema transparente evita la pantalla de presentación cuando se inicia sin actividad de la interfaz de usuario -->
        <activity
            android:name=".auth.OAuthCallbackActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="io.zer0.muse"
                    android:host="oauth"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- Phase 12: Glance Compose widgets de escritorio(Inicie rápidamente conversaciones recientes) -->
        <receiver
            android:name=".widget.MuseQuickWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/muse_quick_widget_info" />
        </receiver>
        <activity
            android:name=".widget.MuseQuickWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.Muse.Starting">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- P3-16: Glance Compose Widget de conversación 4x2 de escritorio(Mostrar respuestas recientes de IA) -->
        <receiver
            android:name=".widget.MuseChatWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/muse_chat_widget_info" />
        </receiver>
        <activity
            android:name=".widget.MuseChatWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.Muse.Starting">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- F-25: Widget de inicio de escritorio(RemoteViews implementación mínima,directo muse://chat) -->
        <receiver
            android:name=".widget.MuseLauncherWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/muse_launcher_widget_info" />
        </receiver>

        <!-- v2.2.1 pantalla virtual:shell Carpeta del lado del servidor de la mano(El servidor dirige la transmisión a este paquete a través de AMS) -->
        <receiver
            android:name=".automation.vdisplay.VirtualDisplayBinderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.zer0.muse.vdproto.BINDER" />
            </intent-filter>
        </receiver>

        <!-- v0.32: Iniciar automáticamente al arrancar receiver(autoLaunch Establecer el estado habilitado del control del interruptor) -->
        <receiver
            android:name=".boot.BootReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- v2.x: Tasker vinculación — La transmisión de una plataforma de automatización externa desencadena una ronda de diálogo.
             exported=true Es una condición necesaria para que Tasker envíe transmisiones entre aplicaciones; el prefijo privado del paquete de nombre de acción evita la activación accidental.
             Y la finalización solo se ejecuta una vez (no se concede la ejecución a la herramienta) y los activadores externos no pueden operar indirectamente el dispositivo. -->
        <receiver
            android:name=".intent.TaskerTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.zer0.muse.action.TASKER_TRIGGER" />
            </intent-filter>
        </receiver>

        <!-- v1.43: Servicio front-end de generación de chat(Mantenga la generación de IA ininterrumpida cuando pase al fondo) -->
        <service
            android:name=".schedule.ChatGenerationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            v2.6.9: Servicio residente keep-alive (activado explícitamente por el usuario).
            Utilice specialUse en lugar de dataSync: no realiza sincronización de datos, pero mantiene canales de programación y mensajes.
            pertenece semánticamente a“Aplicar tareas personalizadas de larga duración”,Android 14+ Es este tipo el que requiere una declaración explícita.
        -->
        <service
            android:name=".schedule.KeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps scheduled tasks and proactive messages alive while the user has opted in" />
        </service>

        <!-- Ventana flotante de registro rápido:Cápsula plegable + tarjeta de entrada compacta -->
        <service
            android:name=".ui.quicknotes.QuickCaptureOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="quick_capture_overlay" />
        </service>

        <!-- P2: Servicio de escucha de notificaciones(Los usuarios deben configurar en el sistema.→Notificación de autorización en derechos de uso) -->
        <service
            android:name=".notification.MuseNotificationListenerService"
            android:label="Muse escucha de notificaciones"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- v1.136: Receptor de despertador con recordatorio regular -->
        <receiver
            android:name=".tools.reminder.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Restablecer la alarma recordatoria después de reiniciar/actualizar la aplicación. Está habilitado de forma predeterminada y no sigue el interruptor "Inicio automático al arrancar":
             Los recordatorios establecidos por los usuarios no deben perderse después del reinicio. Solo reorganice, no reproduzca Actividad. -->
        <receiver
            android:name=".tools.reminder.ReminderBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>


        <!-- archivo adjunto:Se utiliza para compartir archivos en el entorno limitado con otras aplicaciones para abrirlos a través de ACTION_VIEW -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- P3-3: Shizuku Provider — Shizuku SDK Declaración de requisitos,utilizado para la comunicación de carpetas -->
        <!-- authorities=${applicationId}.shizuku,Shizuku Las solicitudes se autorizan a través de este proveedor. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- v1.0.80: UI Servicios automatizados de accesibilidad.
             exported=true ¿Es AccessibilityManager una condición necesaria para que el servicio esté vinculado al sistema?;
             BIND_ACCESSIBILITY_SERVICE Las aplicaciones ordinarias todavía tienen restringida la vinculación directa. -->
        <service
            android:name=".automation.executors.MuseAccessibilityService"
            android:exported="true"
            android:label="@string/automation_permission_a11y"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/muse_accessibility_service" />
        </service>
    </application>

</manifest>
