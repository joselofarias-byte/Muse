    <!-- ===== NotificationListenerScreen.kt ===== -->
    <string name="notif_listener_screen_title">Acceso a notificaciones</string>
    <string name="notif_memory_title">Memoria de notificaciones</string>
    <string name="notif_memory_desc">Al activar esta opción, el asistente resume periódicamente tus notificaciones (entregas, calendario, facturas y compromisos) y las guarda en la memoria para mencionarlas en mensajes proactivos. Las notificaciones pueden contener información privada; actívala solo si lo consideras adecuado.</string>
    <string name="notif_bridge_title">Acceso de puente</string>
    <string name="notif_bridge_desc">Al activarlo para una fuente, su texto de notificación puede entrar al contexto del chat (solo local; las demás siguen ocultas)</string>
    <string name="notif_listener_open_settings_failed">No se pudieron abrir los ajustes del sistema</string>
