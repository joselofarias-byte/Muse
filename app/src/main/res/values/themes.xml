<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v1.7: Aplicar tema principal — Ninguno ActionBar,Dibuja la barra de estado tú mismo con Compose/barra de navegación -->
    <!-- v1.99: Agregue bordes cortos para extender el contenido a la pantalla curva/cutout Distrito,La evitación se maneja mediante inserciones de Redactar -->
    <style name="Theme.Muse" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- API 27+ -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- v1.7: tema de la pantalla de bienvenida — uso androidx.core:core-splashscreen -->
    <style name="Theme.Muse.Starting" parent="Theme.SplashScreen">
        <!-- warm-paper color de fondo -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- icono central: muse logo -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_muse_logo</item>
        <!-- El fondo del icono es consistente con el fondo de la ventana.,Evite los accidentes cerebrovasculares -->
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <!-- Splash Después de terminar, regrese al tema principal. -->
        <item name="postSplashScreenTheme">@style/Theme.Muse</item>
    </style>
</resources>