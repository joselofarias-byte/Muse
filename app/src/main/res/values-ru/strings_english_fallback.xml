    <string name="audit_keep_alive_step_1">Open Settings → Apps → App launch management</string>
    <string name="audit_keep_alive_step_2">Find Muse, disable “Manage automatically”, and manually allow “Auto-launch”, “Secondary launch”, and “Run in background”</string>
    <string name="audit_keep_alive_step_3">In Settings → Battery → More battery settings, remove restrictions on “Stay connected when device sleeps”</string>
    <string name="audit_keep_alive_step_4">Open Settings → App settings → Manage apps → Find Muse</string>
    <string name="audit_keep_alive_step_5">Enable “Auto-launch” and select “No restrictions” under “Battery saver”</string>
    <string name="audit_keep_alive_step_autostart_shortcut">Or open the system auto-launch management page directly (button below)</string>
    <string name="audit_keep_alive_step_7">Open Settings → Apps → App management → Find Muse</string>
    <string name="audit_keep_alive_step_8">Enable “Auto-launch” and select “Allow background activity” under Battery → Power consumption management</string>
    <string name="audit_keep_alive_step_10">Open Settings → Apps and permissions → Permission management → Find Muse</string>
    <string name="audit_keep_alive_step_11">Enable “Auto-launch” and select “Allow background activity” under Battery → High background power consumption</string>
    <string name="audit_keep_alive_step_13">Allow Muse to auto-launch and run in the background in system settings</string>
    <string name="audit_keep_alive_step_14">Set Muse to “Unrestricted” in battery optimization (the button below opens it directly)</string>
    <string name="audit_keep_alive_step_15">Do not use “Force stop”; simply swipe the app away from recent tasks</string>
