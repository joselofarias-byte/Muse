<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Predeterminado: Se permite el tráfico de texto claro.
      
      2026-11 decidir: JS caja de arena (execute_javascript / Herramienta JS complementaria) debe poder acceder a cualquier host http.
      Android La política de seguridad de la red se publica "por nombre de dominio" y no se puede abrir únicamente en el entorno limitado. —— Para soportar cualquier host
      Sólo puedes abrir base-config.
      
      Precio y cobertura:
       - https ya no es obligatorio para todas las aplicaciones (Provider Al utilizar http, aparecerá una advertencia en el registro (baseUrl no es https);
       - Cada vez que se envía el sandbox, se escribirá un registro de auditoría (JsSandbox.httpRequest) para facilitar el retroceso;
       - La zona de pruebas todavía tiene prohibido leer archivos locales y todavía está bloqueada. cookie / sendBeacon / WebSocket Gaiden.
      Si desea retractarse de esto, simplemente cambie el siguiente valor falso (la zona de pruebas ahora solo podrá usar https).
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Excepción de depuración local: localhost texto claro permitido(Para servidor web/depuración local) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
