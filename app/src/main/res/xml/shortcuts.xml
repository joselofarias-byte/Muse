<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher Atajo de pulsación larga:Este menú aparece cuando el usuario mantiene presionado el ícono de la aplicación.,Vaya directamente a la función correspondiente.
     Especificación de referencia de Android ShortcutManager(Hasta 4 atajos estáticos).
     cada uno <shortcut> debe contener shortcutId / icon / shortcutShortLabel,intent Se requieren acción y targetClass. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- nueva conversación:Crea una nueva sesión y ve a la página de inicio. -->
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_chat"
        android:shortcutShortLabel="@string/shortcut_new_chat_short"
        android:shortcutLongLabel="@string/shortcut_new_chat_long">
        <intent
            android:action="io.zer0.muse.ACTION_NEW_CHAT"
            android:targetPackage="io.zer0.muse"
            android:targetClass="io.zer0.muse.MainActivity" />
    </shortcut>

    <!-- Traducción:Abra directamente la página de traducción independiente -->
    <shortcut
        android:shortcutId="translate"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_translate"
        android:shortcutShortLabel="@string/shortcut_translate_short"
        android:shortcutLongLabel="@string/shortcut_translate_long">
        <intent
            android:action="io.zer0.muse.ACTION_TRANSLATE"
            android:targetPackage="io.zer0.muse"
            android:targetClass="io.zer0.muse.MainActivity" />
    </shortcut>

    <!-- Entrada de voz:Vaya a la página de inicio y active la entrada de voz -->
    <shortcut
        android:shortcutId="voice_input"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/shortcut_voice_input_short"
        android:shortcutLongLabel="@string/shortcut_voice_input_long">
        <intent
            android:action="io.zer0.muse.ACTION_VOICE_INPUT"
            android:targetPackage="io.zer0.muse"
            android:targetClass="io.zer0.muse.MainActivity" />
    </shortcut>

    <!-- ajustes:Abra la página de configuración directamente -->
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutShortLabel="@string/shortcut_settings_short"
        android:shortcutLongLabel="@string/shortcut_settings_long">
        <intent
            android:action="io.zer0.muse.ACTION_SETTINGS"
            android:targetPackage="io.zer0.muse"
            android:targetClass="io.zer0.muse.MainActivity" />
    </shortcut>

    <!-- v1.0.18: registro rápido:Abra directamente la página de registro rápido -->
    <shortcut
        android:shortcutId="quick_notes"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_note"
        android:shortcutShortLabel="@string/shortcut_quick_notes_short"
        android:shortcutLongLabel="@string/shortcut_quick_notes_long">
        <intent
            android:action="io.zer0.muse.ACTION_QUICK_NOTES"
            android:targetPackage="io.zer0.muse"
            android:targetClass="io.zer0.muse.MainActivity" />
    </shortcut>

</shortcuts>
