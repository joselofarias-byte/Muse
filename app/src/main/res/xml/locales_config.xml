<?xml version="1.0" encoding="utf-8"?>
<!--
  locales_config.xml — Android 13+ per-app language preferences.

  Declare todos los idiomas admitidos por su aplicación,Configuración del sistema → Estas opciones se enumeran en Idioma de la aplicación.
  Después de que el usuario seleccione,El sistema aplica automáticamente el correspondiente locale,No es necesario cambiar manualmente la capa de aplicación addBaseContext.

  Idiomas admitidos:
    - es (Español, predeterminado)
    - en (English)
    - ja (日本語)
    - ko (한국어)
    - ru (Русский)
    - pt-rBR (Português do Brasil)

  Nota:Se requiere sincronización al agregar nuevos idiomas:
    1. Añadir a este archivo <locale android:name="..."/>
    2. Crear correspondiente values-<locale>/strings_*.xml
    3. Ejecute ci/script/check_localizations.py para verificar la integridad
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="es" />
    <locale android:name="en" />
    <locale android:name="ja" />
    <locale android:name="ko" />
    <locale android:name="ru" />
    <locale android:name="pt-rBR" />
</locale-config>
