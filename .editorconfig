# Muse Declaración de estilo de código —— ktlint Comparta esta copia con el IDE.
#
# fondo: Este almacén anteriormente**No** .editorconfig, ktlint Utilice valores predeterminados integrados durante todo el proceso, Esto crea dos deudas.:
#   1. Los estándares actuales adoptados por el proyecto no tienen clasificación. —— El nuevo código solo puede confiar en"Ver archivos vecinos"Adivina, Y los calibres de las dos herramientas son inconsistentes.
#      (ktlint Incumplimiento bancario 140, detekt Predeterminado 120, El mismo código se contabiliza por separado entre dos gobernantes.);
#   2. @Composable La denominación PascalCase de la función es ilegal mediante la denominación de función —— 803 Puramente falso positivo.
# Este documento hace explícito el estándar.: La única declaración, Aquí ambas puertas están alineadas.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{kt,kts}]
indent_size = 4
# Línea base de estilo.ktlint 1.0 Predeterminado ktlint_official, Habrá adicionales obligatorios. multiline-expression-wrapping /
# function-signature espera"envoltura de expresión"reglas —— Según mediciones reales, el módulo de la aplicación informa más que intellij_idea 8,965 Artículo
# (29,262 vs 20,297), Y el resultado de Ctrl+Alt+L del IDE es pelear entre sí., Es una elección equivocada de gobernante más que un código equivocado.
# Declaración intellij_idea = Haga que el control de acceso tenga el mismo calibre que el formateador utilizado durante el desarrollo.
# La alternativa android_studio forzará 15.000 comas finales adicionales(Medición real 35,429 Artículo), Mayor desviación del código existente, No adoptado.
ktlint_code_style = intellij_idea
# Límite de longitud del banco. Debe ser coherente con detekt.yml style > MaxLineLength > maxLineLength ser consistente(140);
# Si cambia aquí, debe cambiar allí simultáneamente., De lo contrario volverá a"dos gobernantes".
max_line_length = 140
# Compose Acuerdo: @Composable Para funciones combinadas PascalCase(Diferenciar de las funciones ordinarias), Las reglas de nomenclatura están exentas de anotaciones.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Permitir identificadores de comillas invertidas(Nombre de la función de prueba, etc.)No violar las reglas de nomenclatura.
ktlint_ignore_back_ticked_identifier = true
