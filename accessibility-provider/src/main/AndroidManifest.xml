<?xml version="1.0" encoding="utf-8"?>
<!--
    v2.2.1: APK de proveedor independiente accesible.

    objetivos de diseño: Separe los servicios de accesibilidad de la aplicación principal y distribúyalos de forma independiente —— Actualización de la aplicación principal/Reinstalar/cuando lo matan,
    Servicios de accesibilidad(Componentes gestionados por el sistema)no afectado,UI Las capacidades de automatización no se eliminan.

    composición:
     1. A11yProviderAccessibilityService — Ontología del servicio de accesibilidad(Heredar: implementación compartida de accesibilidad),
        obligado por el sistema,Se muestra como independiente en la configuración del sistema."Muse UI Automatización"Artículos de autorización;
     2. A11yBridgeService — AIDL servicio puente,Pasar la instancia de servicio del mismo proceso.
        IAccessibilityProvider Expuesto a la aplicación principal de Muse con la misma firma.(signature Barandilla de permiso de nivel).

    Nota: Derechos antiguos para la aplicación principal(MuseAccessibilityService@aplicación principal)Coexistiendo con los elementos de autorización de este APK,
    La parte principal de la aplicación es responsable del enlace de doble ruta durante el período de migración.(provider Cobertura de servicio prioritario en la aplicación).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Barandilla distintiva:Solo la aplicación principal de Muse con la misma firma puede vincular el servicio puente -->
    <permission
        android:name="io.zer0.muse.permission.A11Y_BRIDGE"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:label="@string/a11y_provider_app_name"
        android:supportsRtl="true">

        <!-- Servicios de accesibilidad:obligado por el sistema(exported=true + BIND_ACCESSIBILITY_SERVICE) -->
        <service
            android:name=".A11yProviderAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_provider_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- AIDL servicio puente:Vincular con firma de la aplicación principal -->
        <service
            android:name=".A11yBridgeService"
            android:exported="true"
            android:permission="io.zer0.muse.permission.A11Y_BRIDGE" />
    </application>

</manifest>
