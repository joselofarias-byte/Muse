# Git ignore for Muse project submodule
.gradle/
.idea/
.kotlin/
build/
build_alt/
*.iml
*.ipr
*.iws
local.properties
keystore.properties
*.keystore
*.jks
*.env
*.log
.DS_Store
Thumbs.db

# Documentación del proyecto (solo se conserva el archivo README de la página de inicio)
/docs/*
!/docs/README.md
!/docs/README_EN.md
!/docs/ENGINEERING_DISCIPLINE.md
!/docs/Mantenimiento de antecedentes y recuperación de procesos.md
!/docs/Lista de activos de devolución.md
!/docs/tech-debt-plan.md
!/docs/refactor-plan-chatviewmodel.md
!/docs/rebuild/
!/docs/rebuild/**
!/docs/assets/
!/docs/assets/readme/
!/docs/assets/readme/**

# Contribuir/seguro/Documentos de planificación (estos no están incluidos en el código del proyecto)
CONTRIBUTING.md
!/CONTRIBUTING.md
SECURITY.md
Muse_Product_Enhancement_Plan.md
_skill_existing.txt
report_*.txt

# archivos temporales
compile_log2.txt
__pycache__/
*.pyc
tmp_head.kt
tmp_*.kt
build_log*.txt
build-log*.txt
build_output*.txt
build-*.txt
.tmp/

# Producto de base de datos de prueba
*.db
*.db-wal
*.db-shm

# Materiales de aplicación suaves
Materiales de aplicación de derechos de autor del software/

# El APK publicado no está incluido en la base de datos.(Cuelgue solo archivos adjuntos de versión de GitHub)
releases/**/*.apk

# F-05: Publicar el manifiesto como un producto de compilación.(Cada construcción genera,No almacenado en el almacén.)
release/

# README Vista previa del producto(gen_preview.py Regenerar en cualquier momento,No almacenado en el almacén.)
docs/assets/readme/preview.html
docs/assets/readme/preview-*.png

# CMake Construir producto(Terminal Fase 2 Construcción Nativa)
.cxx/
**/.cxx/

# P0 Productos de tiempo de ejecución integrados(Generado por herramientas/script de paquete de tiempo de ejecución; distribuido a través de canales de activos independientes,No almacenado en el almacén.)
app/src/main/jniLibs/
app/src/main/assets/muse-runtime-assets.zip
# v2.7 Artefactos de tiempo de ejecución de Python integrados(Generado por el script tools/python-pack; Lo mismo que el anterior pero no incluido en la biblioteca.)
app/src/main/assets/muse-python-assets.zip
# ktlint La línea base temporal generada por la herramienta en el directorio de trabajo (la línea base real está en <module>/ktlint-baseline.xml)
app/config/
